{
  "name": "showpiece",
  "version": "0.1.1",
  "description": "Play Store screenshot pipeline CLI: capture with Maestro, frame with sharp, publish via the Google Play Developer API.",
  "type": "module",
  "license": "MIT",
  "author": "Fernando Cordeiro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrCordeiro/showpiece.git"
  },
  "homepage": "https://github.com/MrCordeiro/showpiece#readme",
  "bugs": {
    "url": "https://github.com/MrCordeiro/showpiece/issues"
  },
  "keywords": [
    "play-store",
    "screenshots",
    "maestro",
    "expo",
    "react-native",
    "google-play"
  ],
  "bin": {
    "showpiece": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "assets", "skills"],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "vendor:fonts": "node scripts/vendor-fonts.mjs",
    "golden:update": "node scripts/generate-golden-fixtures.mjs",
    "prepack": "npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@googleapis/androidpublisher": "^42.1.0",
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "fontkit": "^2.0.4",
    "jiti": "^2.4.2",
    "sharp": "^0.35.4",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/metropolis": "^5.3.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.11",
    "husky": "^9.1.7",
    "pixelmatch": "^7.2.0",
    "tsdown": "^0.22.9",
    "typescript": "^5.7.2",
    "unrun": "^0.3.1",
    "vitest": "^4.1.11"
  }
}
